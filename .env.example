# sf-core runtime. Copy to .env and keep .env untracked.

SF_HOST=127.0.0.1
SF_PORT=8088
SF_DEFAULT_DOMAIN=python
SF_MAX_TELEMETRY_COORDS=8

# Browser origin for the gateway. Empty or * allows any origin.
SF_CORS_ORIGIN=

# Embedder seams. gRPC is preferred. HTTP is the fallback.
TEI_GRPC_URL=http://127.0.0.1:8080
TEI_HTTP_URL=http://127.0.0.1:8080
SF_EMBEDDER=mock

# LanceDB directory for domain hypercubes.
LANCEDB_URI=data/sf-lancedb

# Request budget. The 3-tier gate SLA excludes the embedder forward pass.
REQUEST_TIMEOUT_SECONDS=30
LOG_LEVEL=info

# =============================================================================
# UPSTREAM LLM PROVIDERS CONFIGURATION (.env)
# -----------------------------------------------------------------------------
# Fill your API keys below. The GUI Diagnostic Studio and sf-proxy will
# automatically detect and load these keys when "Usar keys de .env" is checked.
# =============================================================================

# --- Gemini (Google AI Studio / Vertex) ---
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.8-flash
# Alternative Gemini variables (optional):
# GOOGLE_API_KEY=
# GEMINI_PROJECT_NAME=
# GEMINI_PROJECT_NUIMBER=
# GEMINIT_API_NAME=

# --- DeepSeek ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Groq ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# --- Ollama / Local OpenAI-compatible Daemon ---
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3
UPSTREAM_LLM_BASE_URL=http://127.0.0.1:11434
UPSTREAM_LLM_API_KEY=
