# =============================================================================
# TRANSPARENT DEV PROTOCOL — environment template for services & LLM components
# -----------------------------------------------------------------------------
# Usage in a new app:
#   1. Copy this file to the workspace ROOT as `.env.example` and commit it.
#   2. Copy it again to `.env`, fill in real values, and KEEP `.env` GITIGNORED.
#
# Rules (transparent-dev-protocol skill, SKILL.md §3.2):
#   - Secrets (keys/tokens) live here, never in code, never committed.
#   - `.env.example` documents the variables WITHOUT real values.
#   - Model / provider / endpoint are configuration, not hardcoded constants.
#
# Document only the variables your app actually reads; delete the rest.
# =============================================================================

# --- Service Runtime & Networking --------------------------------------------
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# --- Local Inference / Embedder Backend (e.g. TEI / ONNX / Ollama / vLLM) ----
# Endpoint of the locally running inference engine / daemon.
LOCAL_EMBEDDER_URL=http://localhost:8080
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=

# --- Remote Provider (Hosted API: OpenAI / Anthropic / Groq / etc.) -----------
# Leave blank in this template; fill real values only in your local uncommitted .env.
LLM_PROVIDER=local
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=

# --- Invariants & Execution Limits (Configuration, not literals in code) -----
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
REQUEST_TIMEOUT_SECONDS=30

# --- Telemetry & Observability -----------------------------------------------
# Structured metrics for latency (p50/p99), token consumption, and memory footprint.
METRICS_ENABLED=true
